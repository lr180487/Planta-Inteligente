# ============================================================
# AgroClima Digital Twin - Environment configuration
# Copy this file to .env and replace values for your environment.
# NEVER commit .env or real credentials to Git.
# ============================================================

# Application
APP_NAME=AgroClima Digital Twin
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_TIMEZONE=America/Lima
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:1880

# Security - generate a unique random secret before deployment
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_GENERATE_ANOTHER_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=agroclima
POSTGRES_USER=agroclima_user
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql+asyncpg://agroclima_user:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/agroclima

# Optional synchronous database URL for migrations/scripts
DATABASE_URL_SYNC=postgresql+psycopg://agroclima_user:CHANGE_ME_DATABASE_PASSWORD@127.0.0.1:5432/agroclima

# Redis
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PASSWORD=

# MQTT Broker - local development
MQTT_ENABLED=true
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=agroclima-backend
MQTT_USERNAME=CHANGE_ME_MQTT_USER
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_TLS_ENABLED=false
MQTT_CA_CERT=
MQTT_KEEPALIVE=60
MQTT_QOS=1
MQTT_TOPIC_TELEMETRY=agroclima/+/telemetry
MQTT_TOPIC_STATUS=agroclima/+/status
MQTT_TOPIC_EVENTS=agroclima/+/event

# OpenPLC / Modbus TCP
PLC_ENABLED=true
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_UNIT_ID=1
PLC_TIMEOUT_SECONDS=2
PLC_RECONNECT_SECONDS=3
PLC_POLL_INTERVAL_SECONDS=2
PLC_READ_START_ADDRESS=0
PLC_READ_REGISTER_COUNT=5
PLC_COMMAND_REGISTER_ADDRESS=10
PLC_STATE_REGISTER_ADDRESS=11
PLC_ALARM_REGISTER_ADDRESS=12

# ESP32 / device registration
DEVICE_AUTH_REQUIRED=true
DEVICE_DEFAULT_ID=esp32-agroclima-01
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=90

# LangGraph / LangChain / LLM
AI_ENABLED=false
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=30
LANGGRAPH_CHECKPOINT_BACKEND=memory

# Optional provider fallbacks
GOOGLE_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Agent behavior
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=60
AGENT_REQUIRE_VERIFICATION=true
AGENT_ALLOW_PLC_WRITES=false

# Telemetry / alert thresholds (demonstration defaults; calibrate for the crop/site)
RAIN_ALERT_THRESHOLD_MM=50
SOIL_MOISTURE_LOW_THRESHOLD_PCT=30
HUMIDITY_HIGH_THRESHOLD_PCT=90
SOLAR_HIGH_THRESHOLD_WM2=900

# Caching / retention
TELEMETRY_RETENTION_DAYS=365
TELEMETRY_BATCH_SIZE=500

# Observability
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agroclima-api
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

# Frontend integration
FRONTEND_ORIGIN=http://127.0.0.1:8000
NODE_RED_URL=http://127.0.0.1:1880
